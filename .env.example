# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/enquiry-system?retryWrites=true&w=majority

# JWT secret key (use a long random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Backend URL (your Render URL after deployment)
BACKEND_URL=https://your-app-name.onrender.com

# Frontend URL (for password reset links)
CLIENT_URL=https://your-frontend-url.com

# Gmail credentials for sending emails
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Super Admin credentials (for createSuperAdmin.js script)
SUPER_ADMIN_EMAIL=admin01@gmail.com
SUPER_ADMIN_PASSWORD=your_strong_password_here
